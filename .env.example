# Copy to .env and fill in your own values. Never commit the real .env file.

# --- signal-bridge ---
# Address of the mt5-windows container/VM on your network (its LAN IP or
# container name if using Docker's internal DNS on a shared network).
ZMQ_HOST=mt5-windows
ZMQ_PORT=5555

# Long random string. Must match the `secret=` field you put in your
# TradingView alert message. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-value
REQUIRE_WEBHOOK_SECRET=true

# --- cloudflared ---
# Token for a named tunnel you create in the Cloudflare Zero Trust
# dashboard. See docs/cloudflare-tunnel-setup.md.
TUNNEL_TOKEN=

# --- mt5-windows (dockur/windows) ---
RAM_SIZE=8G
CPU_CORES=2
DISK_SIZE=64G

# Your own Windows account inside the VM (not your MT5 broker login).
WINDOWS_USERNAME=Docker
WINDOWS_PASSWORD=change-me

# Your MT5 broker account -- never share these or commit them.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=EURUSD
