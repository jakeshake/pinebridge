# Copy to .env and fill in your own values. Never commit the real .env file.

# --- pinebridge-bridge ---
# Address of the pinebridge-mt5 container/VM on your network (its LAN IP or
# container name if using Docker's internal DNS on a shared network).
ZMQ_HOST=pinebridge-mt5
ZMQ_PORT=5555

# Leave blank to have one generated on first start (saved in
# data/config/webhook_secret; the full webhook URL is printed in the
# pinebridge-bridge log). Or set your own: openssl rand -hex 32
WEBHOOK_SECRET=
REQUIRE_WEBHOOK_SECRET=true
# Optional: your tunnel's https address, so the log prints the exact
# TradingView webhook URL (https://<this>/webhook?secret=...).
PUBLIC_URL=

# --- pinebridge-tunnel (cloudflared) ---
# Token for a named tunnel you create in the Cloudflare Zero Trust
# dashboard. See docs/cloudflare-tunnel-setup.md.
TUNNEL_TOKEN=

# --- pinebridge-mt5 (dockur/windows) ---
RAM_SIZE=8G
CPU_CORES=2
DISK_SIZE=64G

# Your own Windows account inside the VM (not your MT5 broker login).
WINDOWS_USERNAME=Docker
WINDOWS_PASSWORD=change-me

# Your MT5 broker account -- never share these or commit them.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=EURUSD
