# Copy to .env and fill in your own values. Never commit the real .env file.
# Only the MT5_* lines and WINDOWS_PASSWORD need editing for a first start.

# Your timezone, e.g. America/New_York (used for log timestamps).
TZ=UTC

# --- pinebridge-mt5 (Windows 11 VM running MetaTrader 5) ---
# Your MT5 broker account. Start with a DEMO account. These are only read
# on the very first boot; to change them later, log in again inside MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=EURUSD

# The Windows account inside the VM (not your broker login).
WINDOWS_USERNAME=Docker
WINDOWS_PASSWORD=change-me

# VM size. 8G RAM / 2 cores is the tested setup; 4G is Windows 11's minimum.
# The disk file grows as it's used (about 17 GB after install).
RAM_SIZE=8G
CPU_CORES=2
DISK_SIZE=64G

# --- pinebridge-bridge ---
# Where the EA's ZeroMQ port is. The default reaches the pinebridge-mt5
# service in docker-compose.yml. If MT5 runs on your own Windows PC or VM
# instead, put that machine's LAN IP here.
ZMQ_HOST=pinebridge-mt5
ZMQ_PORT=5555

# Leave blank to have one generated on first start (saved in
# data/config/webhook_secret; the full webhook URL is printed in the
# pinebridge-bridge log). Or set your own: openssl rand -hex 32
WEBHOOK_SECRET=
REQUIRE_WEBHOOK_SECRET=true
# Optional: your tunnel's https address, so the log prints the exact
# TradingView webhook URL (https://<this>/webhook?secret=...).
PUBLIC_URL=
# Optional password for the dashboard on port 8081 (LAN only).
DASHBOARD_PASSWORD=

# --- pinebridge-tunnel (optional: docker compose --profile tunnel up -d) ---
# Token for a tunnel you create in the Cloudflare Zero Trust dashboard.
# See docs/cloudflare-tunnel-setup.md.
TUNNEL_TOKEN=
